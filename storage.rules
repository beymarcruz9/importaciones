rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      // Lectura pública de las imágenes de los productos
      allow read: if true;
      // Subida de fotos permitida únicamente al administrador autenticado
      allow write: if request.auth != null && 
        request.auth.token.email.lower() == 'cruz.arias.beymar@itsecsucre.edu.bo';
    }
  }
}
